{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Comprehensive Postman collection for Wholesale ERP/CRM with Auth, Customers, Inventory, Sales Challans and RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "salesToken", "value": "", "type": "string" },
    { "key": "warehouseToken", "value": "", "type": "string" },
    { "key": "accountsToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Sales",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('salesToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('warehouseToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set('accountsToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Operations Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["dashboard", "stats"] }
          }
        }
      ]
    },
    {
      "name": "3. Customer CRM",
      "item": [
        {
          "name": "List Customers (Search & Filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?status=ACTIVE&customerType=WHOLESALE",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "status", "value": "ACTIVE" },
                { "key": "customerType", "value": "WHOLESALE" }
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{salesToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Varma\",\n  \"mobile\": \"+91 98330 11223\",\n  \"email\": \"orders@varmatraders.in\",\n  \"businessName\": \"Varma Wholesale Hub\",\n  \"gstNumber\": \"27AABCV5566G1Z2\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"Shop 40, APMC Market Yard, Navi Mumbai - 400705\",\n  \"status\": \"ACTIVE\",\n  \"followUpDate\": \"2026-09-20\",\n  \"notes\": \"Specializes in retail logistics and corrugated packaging.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Add Follow-up Note to Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{salesToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed Q4 bulk purchase schedule for thermal label rolls.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:customerId/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":customerId", "notes"],
              "variable": [{ "key": "customerId", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Products & Stock",
      "item": [
        {
          "name": "List Products (with Low Stock Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{warehouseToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/products?lowStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "lowStock", "value": "true" }]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Heavy Duty Poly Strapping Roll 19mm\",\n  \"sku\": \"PROD-PACK-105\",\n  \"category\": \"Packaging\",\n  \"unitPrice\": 840,\n  \"currentStock\": 60,\n  \"minStockAlert\": 15,\n  \"location\": \"Warehouse B - Bay 05\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Adjust Stock (IN / OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 25,\n  \"movementType\": \"IN\",\n  \"reason\": \"Inward stock from Supplier PO #704\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:productId/adjust-stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":productId", "adjust-stock"],
              "variable": [{ "key": "productId", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Inventory Movement Logs",
      "item": [
        {
          "name": "Get Stock Movement Audit Trail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{warehouseToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory/logs?movementType=OUT",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "logs"],
              "query": [{ "key": "movementType", "value": "OUT" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Sales Challans",
      "item": [
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Create Sales Challan (Confirmed - Auto Deducts Stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{salesToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"replace-with-customer-id\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"replace-with-product-id\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Update Challan Status (Confirm Draft / Cancel)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{salesToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/:challanId/status",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":challanId", "status"],
              "variable": [{ "key": "challanId", "value": "" }]
            }
          }
        },
        {
          "name": "View Printable Tax Invoice HTML / PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/challans/:challanId/invoice-html",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":challanId", "invoice-html"],
              "variable": [{ "key": "challanId", "value": "" }]
            }
          }
        }
      ]
    }
  ]
}
